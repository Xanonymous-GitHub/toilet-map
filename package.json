{
  "name": "jp-kr-toilet-map",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --host 0.0.0.0",
    "build": "bun --bun vite build && bun scripts/build-worker.mjs && bun run typecheck",
    "typecheck": "bun --bun tsc --noEmit && bun --bun tsc --noEmit -p tsconfig.sw.json",
    "setup:qa": "bun install --cwd tooling/netlify --frozen-lockfile",
    "test": "bun run setup:qa && bun test tests && uv run --locked python -m unittest discover -s tests -p 'test_*.py'",
    "preview": "bun scripts/serve.mjs",
    "lint": "bun --bun biome check . --error-on-warnings && uv run --locked ruff check . && uv run --locked ruff format --check .",
    "format": "bun --bun biome check --write . && uv run --locked ruff check --fix . && uv run --locked ruff format .",
    "check": "bun run lint && bun run typecheck",
    "verify": "bun run build && bun run check && bun run test",
    "test:browser": "uv run --locked python scripts/browser-qa.py",
    "deps:check": "uv run --locked python scripts/check-dependencies.py",
    "data:expand": "uv run --locked python scripts/import-expansion.py"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.55.0",
    "maplibre-gl": "6.14.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@rollup/plugin-terser": "1.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/html-minifier-terser": "7.0.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "cssnano": "9.6.0",
    "html-minifier-terser": "7.2.0",
    "lighthouse": "13.5.0",
    "lightningcss": "1.33.0",
    "rolldown": "1.2.13",
    "rollup-plugin-license": "3.7.1",
    "shadcn": "4.21.4",
    "svgo": "4.1.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
